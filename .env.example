# ========================
# Database - PostgreSQL
# ========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=artistas_albuns
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ========================
# MinIO - Object Storage
# ========================
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=albuns-capas
MINIO_PRESIGNED_URL_EXPIRY=1800

# ========================
# Backend - Quarkus
# ========================
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=dev

# JWT Configuration
JWT_SECRET=sua-chave-secreta-muito-longa-e-segura-aqui-min-256-bits
JWT_ISSUER=artistas-albuns-api
JWT_EXPIRATION_SECONDS=300
JWT_REFRESH_EXPIRATION_SECONDS=86400

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ========================
# Frontend - Next.js
# ========================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ========================
# External API (Regionais)
# ========================
EXTERNAL_API_URL=https://api-publica-mt.seplag.mt.gov.br
